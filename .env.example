# Copy to .env and fill. Never commit .env.

# ── Core ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/reorder_line
AGENT_TOOL_SECRET=            # openssl rand -hex 32 — signs the agent→app tool calls
PUBLIC_BASE_URL=              # your cloudflared/ngrok https URL (tools + webhooks)
LANGUAGE_LOCALE=en   # deploy toggle: which agent serve.py/sync_agent builds & assigns to the number
DEFAULT_LOCALE=en    # runtime fallback language for the written offer if a call doesn't specify one

# ── ElevenLabs ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=          # the English agent (reorder-line-en)
ELEVENLABS_AGENT_ID_BN=       # the Bangla agent (reorder-line-bn), printed on first bn sync
ELEVENLABS_WEBHOOK_SECRET=    # HMAC secret for inbound ElevenLabs webhooks (optional).

# ── Twilio (voice + SMS) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # E.164, e.g. +15551234567

# ── Email offer (Gmail SMTP) ───────────────────────────────────────
GMAIL_ADDRESS=               # the sending Gmail account (also the From: address)
GMAIL_APP_PASSWORD=          # 16-char app password, base64-encoded

# ── Demo helpers (optional) ────────────────────────────────────────
DEMO_CALLER_PHONE=
DEMO_SHOP_NAME=
