# Copy to .env and fill. Never commit .env.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reorder_line"

# Shared secret the ElevenLabs agent sends as x-agent-secret on every tool call.
# Generate with: openssl rand -hex 32
AGENT_TOOL_SECRET=""

ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""

TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Final offer email (Phase 4)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# en | bn
DEFAULT_LOCALE="en"
